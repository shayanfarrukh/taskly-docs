{
  "info": {
    "name": "JSONPlaceholder API Test",
    "description": "Portfolio sample: functional tests for the public JSONPlaceholder REST API (https://jsonplaceholder.typicode.com). Covers list, retrieve, create, replace, update, delete, an error case and an edge case. Collection-level tests check response time and content type on every request. JSONPlaceholder simulates writes and does not save them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response time is under 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
          "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 List posts by user",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        },
        "description": "Returns all posts written by one user. Checks filtering and array shape."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body is a non-empty array\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"Every post belongs to the requested user\", () => {",
              "  const userId = Number(pm.collectionVariables.get(\"userId\"));",
              "  pm.response.json().forEach(post => pm.expect(post.userId).to.eql(userId));",
              "});",
              "pm.test(\"Each post has the expected fields\", () => {",
              "  pm.response.json().forEach(post => pm.expect(post).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Get one post",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Retrieves a single post by ID and checks its fields and types."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns the requested post\", () => {",
              "  const post = pm.response.json();",
              "  pm.expect(post.id).to.eql(Number(pm.collectionVariables.get(\"postId\")));",
              "});",
              "pm.test(\"Fields have the expected types\", () => {",
              "  const post = pm.response.json();",
              "  pm.expect(post.userId).to.be.a(\"number\");",
              "  pm.expect(post.title).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(post.body).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List comments for a post",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}",
            "comments"
          ]
        },
        "description": "Tests a nested resource: comments that belong to one post."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Every comment belongs to the post\", () => {",
              "  const postId = Number(pm.collectionVariables.get(\"postId\"));",
              "  const comments = pm.response.json();",
              "  pm.expect(comments).to.be.an(\"array\").that.is.not.empty;",
              "  comments.forEach(c => pm.expect(c.postId).to.eql(postId));",
              "});",
              "pm.test(\"Every comment has a valid-looking email\", () => {",
              "  pm.response.json().forEach(c => pm.expect(c.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create a post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Creates a post. JSONPlaceholder simulates the write: it returns the new resource but does not save it.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman portfolio test\",\n  \"body\": \"Created by an automated Postman test.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response echoes the submitted data\", () => {",
              "  const sent = JSON.parse(pm.request.body.raw);",
              "  const created = pm.response.json();",
              "  pm.expect(created.title).to.eql(sent.title);",
              "  pm.expect(created.body).to.eql(sent.body);",
              "  pm.expect(created.userId).to.eql(sent.userId);",
              "});",
              "pm.test(\"A new numeric id is returned\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Replace a post (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Replaces a whole post. All fields are sent.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Replaced title\",\n  \"body\": \"Replaced body text.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contains the replacement data\", () => {",
              "  const sent = JSON.parse(pm.request.body.raw);",
              "  const updated = pm.response.json();",
              "  pm.expect(updated.id).to.eql(Number(pm.collectionVariables.get(\"postId\")));",
              "  pm.expect(updated.title).to.eql(sent.title);",
              "  pm.expect(updated.body).to.eql(sent.body);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Update part of a post (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Changes only the title. Other fields should be unchanged.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Patched title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Title is updated\", () => pm.expect(pm.response.json().title).to.eql(\"Patched title\"));",
              "pm.test(\"Fields that were not sent are still present\", () => {",
              "  const post = pm.response.json();",
              "  pm.expect(post).to.have.property(\"body\").that.is.a(\"string\").and.not.empty;",
              "  pm.expect(post).to.have.property(\"userId\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Delete a post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Deletes a post. JSONPlaceholder simulates this and returns an empty object."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body is an empty object\", () => pm.expect(pm.response.json()).to.eql({}));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Error case: post does not exist",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "9999"
          ]
        },
        "description": "Negative test: requesting an ID that does not exist."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"Body is an empty object\", () => pm.expect(pm.response.json()).to.eql({}));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Edge case: filter with no matches",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId=9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "9999"
            }
          ]
        },
        "description": "Boundary test: filtering by a user that does not exist should return an empty list, not an error."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body is an empty array\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    }
  ]
}